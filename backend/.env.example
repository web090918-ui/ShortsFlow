SHORTSFLOW_APP_NAME=ShortsFlow API
SHORTSFLOW_APP_ENV=development
SHORTSFLOW_LOG_LEVEL=INFO
SHORTSFLOW_FRONTEND_ORIGIN=http://localhost:3000
# Optional Whisper fallback used only when the source has no captions for the selected range.
SHORTSFLOW_OPENAI_API_KEY=
SHORTSFLOW_OPENAI_STT_MODEL=whisper-1

# Task 04 defaults stay local. Use the values below on Cloud Run.
SHORTSFLOW_JOB_REPOSITORY_BACKEND=memory
SHORTSFLOW_TASK_DISPATCHER_BACKEND=local
SHORTSFLOW_WORKER_AUTH_MODE=disabled
# SHORTSFLOW_GCP_PROJECT_ID=your-project-id
SHORTSFLOW_GCP_LOCATION=asia-northeast3
SHORTSFLOW_FIRESTORE_DATABASE=(default)
SHORTSFLOW_CLOUD_TASKS_QUEUE=shortsflow-processing
# SHORTSFLOW_WORKER_URL=https://shortsflow-worker-xxxxx-an.a.run.app
# SHORTSFLOW_WORKER_OIDC_AUDIENCE=https://shortsflow-worker-xxxxx-an.a.run.app
# SHORTSFLOW_WORKER_SERVICE_ACCOUNT_EMAIL=shortsflow-tasks@your-project-id.iam.gserviceaccount.com
SHORTSFLOW_PROCESSING_MAX_ATTEMPTS=3

# Apify Titan is the only production provider for metadata, captions, and media.
# "auto" uses Titan when the token is set, else yt-dlp locally (residential IPs only).
SHORTSFLOW_SHORTS_ACQUISITION_PROVIDER=auto
SHORTSFLOW_APIFY_API_TOKEN=
SHORTSFLOW_APIFY_TITAN_ACTOR_ID=titan_network~titan-youtube-video-downloader
SHORTSFLOW_APIFY_TITAN_QUALITY=1080
SHORTSFLOW_APIFY_RUN_TIMEOUT_SECONDS=480
# local keeps rendered Shorts on disk; gcs uploads to SHORTSFLOW_GCS_BUCKET and returns signed URLs.
SHORTSFLOW_SHORTS_STORAGE_BACKEND=local
# SHORTSFLOW_SHORTS_LOCAL_STORAGE_DIR=
# SHORTSFLOW_GCS_BUCKET=shortsflow-shorts
SHORTSFLOW_SHORTS_DOWNLOAD_TTL_SECONDS=86400
SHORTSFLOW_SHORTS_MAX_CLIP_SECONDS=180

# Task 06 clip candidates derived from the transcript (seconds and counts)
SHORTSFLOW_CANDIDATE_MIN_SECONDS=15
SHORTSFLOW_CANDIDATE_MAX_SECONDS=60
SHORTSFLOW_CANDIDATE_COUNT_MIN=10
SHORTSFLOW_CANDIDATE_COUNT_MAX=15
